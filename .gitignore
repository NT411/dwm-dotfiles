/config/dmenu/dmenu-*.tar.gz
/config/st/st-*.tar.gz
/config/st/scroll/scroll-*.tar.gz
/config/slstatus/slstatus-*.tar.gz
/config/slock/slock-*.tar.gz

# Logs and installer backups
*.log
.RiceBackup/

# Local application state and credentials
/config/gh/hosts.yml
/config/deskctl/session-state.json
/config/qutebrowser/autoconfig.yml
/config/qutebrowser/config.py.before-*
/config/qutebrowser/sessions/
/config/micro/backups/
/config/micro/buffers/
/config/micro/log.txt
/config/mc/history
/home/.bash_history
/home/.lesshst
/home/.Xauthority


*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Compiled suckless programs (keep custom config.h files)
*.o
/config/dwm/dwm
/config/dmenu/dmenu
/config/dmenu/stest
/config/st/st
/config/st/scroll/scroll
/config/st/scroll/ptty
/config/slstatus/slstatus
/config/slock/slock

